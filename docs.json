  "redirects": [
    {
      "source": "/automation/ai-agent",
      "destination": "/automation/ai-employees"
    }
  ],
  "logo": {
    "light": "/images/favicon_512x512_png.png",
    "dark": "/images/Autocampaign-Logo-transperant.png",
    "href": "https://docs.autocampaign.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@autocampaign.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.autocampaign.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "website": "https://autocampaign.ai",
      "github": "https://github.com/autocampaign-ai/mintlify-docs"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Autocampaign AI Help Center",
      "og:type": "website",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image"
    },
    "indexing": "navigable"
  },
  "description": "Guides for SMS, email, WhatsApp, calls, CRM, campaigns, automation and AI Employees in Autocampaign AI.",
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0F172A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
