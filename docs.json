  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@autocampaign.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.autocampaign.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
